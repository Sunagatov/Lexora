POSTGRES_DB=lexora_db
POSTGRES_USER=lexora_postgres_db_user
POSTGRES_PASSWORD=customfakepass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

APP_PASSWORD=customfakepass
SECRET_KEY=customfakepass
COOKIE_MAX_AGE=2592000
API_KEY=change-me-before-sharing

# Smart Review
SMART_REVIEW_ENABLED=true
SMART_REVIEW_SIZE=100
SMART_REVIEW_LEVEL_1_COUNT=25
SMART_REVIEW_LEVEL_2_COUNT=25
SMART_REVIEW_LEVEL_3_COUNT=25
SMART_REVIEW_LEVEL_4_COUNT=25
SMART_REVIEW_LEVEL_5_COUNT=0
SMART_REVIEW_COOLDOWN_DAYS=2
SMART_REVIEW_MAX_PER_TOPIC=10
SMART_REVIEW_QUEUE_TTL_HOURS=24

# Trash
TRASH_RETENTION_DAYS=30

# AI — GitHub Models (OpenAI-compatible, gpt-4o-mini)
OPENAI_API_KEY=customfakepass
OPENAI_BASE_URL=https://models.inference.ai.azure.com
OPENAI_MODEL=gpt-4o-mini

# Frontend (Vite build-time)
VITE_API_BASE_URL=http://localhost:8000
VITE_PAGE_SIZES=10,20,50,100
VITE_DEFAULT_PAGE_SIZE=20
